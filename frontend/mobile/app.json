{
  "expo": {
    "name": "RideSafe",
    "slug": "aegis-hyyjuv8s4-am-3yvatvin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/productlogo.png",
    "scheme": "ridesafe",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow RideSafe to use your location to calculate real-time safety risks and determine claim viability.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow RideSafe to use your location to calculate real-time safety risks and determine claim viability."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/productlogo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "package": "com.sriram018.RideSafe",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/productlogo.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/productlogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow RideSafe to use your location to calculate real-time safety risks and determine claim viability.",
          "locationWhenInUsePermission": "Allow RideSafe to access your location to show live risk zones.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b0af4d43-bf83-4b20-b61d-94d06becc31c"
      }
    },
    "owner": "sriramvks-organization"
  }
}