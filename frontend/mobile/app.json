{
  "expo": {
    "name": "RideSafe",
    "slug": "aegis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ProductLogo.png",
    "scheme": "ridesafe",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/ProductLogo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sriram018.RideSafe"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ProductLogo.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ProductLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "c2779d45-7d6d-4625-b4b8-4f44e812f552"
      }
    },
    "owner": "sriram018s-organization"
  }
}
