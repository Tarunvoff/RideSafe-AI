import React, { useState } from 'react';
import { View, Text, StyleSheet, SafeAreaView, TouchableOpacity, ScrollView } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { Theme } from '../../theme';
import Button from '../../components/Button';

export default function KYCIdentityVerificationScreen({ navigation }: any) {
  const [selectedDoc, setSelectedDoc] = useState('aadhaar');

  return (
    <SafeAreaView style={styles.safeArea}>
      <View style={styles.header}>
        <View style={styles.headerTop}>
          <TouchableOpacity onPress={() => navigation.goBack()} style={styles.backButton}>
            <Ionicons name="arrow-back" size={24} color={Theme.colors.text} />
          </TouchableOpacity>
          <Text style={styles.headerTitle}>Quick KYC</Text>
          <View style={{ width: 40 }} />
        </View>
        <View style={styles.progressContainer}>
          <View style={styles.progressHeader}>
            <Text style={styles.progressPercent}>Step 2 of 3</Text>
            <Text style={styles.progressText}>Identity Verification</Text>
          </View>
          <View style={styles.progressBarBg}>
            <View style={[styles.progressBarFill, { width: '66%' }]} />
          </View>
        </View>
      </View>

      <ScrollView contentContainerStyle={styles.container}>
        <Text style={styles.title}>Identity Verification</Text>
        <Text style={styles.subtitle}>Select one document to verify your identity and start delivering.</Text>

        <View style={styles.docList}>
          <TouchableOpacity 
            style={[styles.docOption, selectedDoc === 'aadhaar' && styles.docOptionSelected]}
            onPress={() => setSelectedDoc('aadhaar')}
          >
            <View style={styles.docInfo}>
              <View style={[styles.docIcon, selectedDoc === 'aadhaar' && styles.docIconSelected]}>
                <Ionicons name="card" size={24} color={selectedDoc === 'aadhaar' ? Theme.colors.primary : Theme.colors.textSecondary} />
              </View>
              <View>
                <Text style={styles.docName}>Aadhaar Card</Text>
                <Text style={styles.docDesc}>Fastest verification</Text>
              </View>
            </View>
            <View style={[styles.radio, selectedDoc === 'aadhaar' && styles.radioSelected]}>
              {selectedDoc === 'aadhaar' && <View style={styles.radioInner} />}
            </View>
          </TouchableOpacity>

          <TouchableOpacity 
            style={[styles.docOption, selectedDoc === 'pan' && styles.docOptionSelected]}
            onPress={() => setSelectedDoc('pan')}
          >
            <View style={styles.docInfo}>
              <View style={[styles.docIcon, selectedDoc === 'pan' && styles.docIconSelected]}>
                <Ionicons name="card-outline" size={24} color={selectedDoc === 'pan' ? Theme.colors.primary : Theme.colors.textSecondary} />
              </View>
              <View>
                <Text style={styles.docName}>PAN Card</Text>
                <Text style={styles.docDesc}>Official tax document</Text>
              </View>
            </View>
            <View style={[styles.radio, selectedDoc === 'pan' && styles.radioSelected]}>
              {selectedDoc === 'pan' && <View style={styles.radioInner} />}
            </View>
          </TouchableOpacity>

          <TouchableOpacity 
            style={[styles.docOption, selectedDoc === 'dl' && styles.docOptionSelected]}
            onPress={() => setSelectedDoc('dl')}
          >
            <View style={styles.docInfo}>
              <View style={[styles.docIcon, selectedDoc === 'dl' && styles.docIconSelected]}>
                <Ionicons name="car" size={24} color={selectedDoc === 'dl' ? Theme.colors.primary : Theme.colors.textSecondary} />
              </View>
              <View>
                <Text style={styles.docName}>Driving License</Text>
                <Text style={styles.docDesc}>Required for bike/car</Text>
              </View>
            </View>
            <View style={[styles.radio, selectedDoc === 'dl' && styles.radioSelected]}>
              {selectedDoc === 'dl' && <View style={styles.radioInner} />}
            </View>
          </TouchableOpacity>
        </View>

        <Text style={styles.sectionTitle}>UPLOAD PHOTO</Text>
        <TouchableOpacity style={styles.uploadArea}>
          <View style={styles.uploadIconContainer}>
            <Ionicons name="camera" size={32} color={Theme.colors.primary} />
          </View>
          <Text style={styles.uploadText}>Capture Front Side</Text>
          <Text style={styles.uploadSubtext}>Ensure the card is clearly visible in good light</Text>
        </TouchableOpacity>

        <View style={styles.secureNotice}>
          <Ionicons name="shield-checkmark" size={20} color={Theme.colors.primary} />
          <Text style={styles.secureText}>
            Your documents are encrypted and securely stored. We only use them for identity verification purposes.
          </Text>
        </View>
      </ScrollView>

      <View style={styles.footer}>
        <Button 
          title="Next" 
          onPress={() => navigation.navigate('KYCPayoutSetup')} 
          icon="arrow-forward"
        />
        <Text style={styles.footerDocs}>By continuing, you agree to our Terms of Service</Text>
      </View>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  safeArea: { flex: 1, backgroundColor: Theme.colors.background },
  header: { borderBottomWidth: 1, borderBottomColor: Theme.colors.border, backgroundColor: Theme.colors.surface },
  headerTop: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: Theme.spacing.md },
  backButton: { padding: Theme.spacing.xs, marginLeft: -8 },
  headerTitle: { ...Theme.typography.h3, color: Theme.colors.text },
  progressContainer: { paddingHorizontal: Theme.spacing.lg, paddingBottom: Theme.spacing.lg },
  progressHeader: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: Theme.spacing.sm },
  progressPercent: { ...Theme.typography.caption, fontWeight: 'bold' as const, color: Theme.colors.primary },
  progressText: { ...Theme.typography.caption, fontWeight: 'bold' as const, color: Theme.colors.textSecondary },
  progressBarBg: { height: 8, backgroundColor: Theme.colors.border, borderRadius: Theme.borderRadius.full },
  progressBarFill: { height: 8, backgroundColor: Theme.colors.primary, borderRadius: Theme.borderRadius.full },
  container: { padding: Theme.spacing.lg },
  title: { ...Theme.typography.h1, color: Theme.colors.text, marginBottom: Theme.spacing.xs },
  subtitle: { ...Theme.typography.body, color: Theme.colors.textSecondary, marginBottom: Theme.spacing.xl },
  docList: { gap: Theme.spacing.md, marginBottom: Theme.spacing.xl },
  docOption: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: Theme.spacing.md, borderRadius: Theme.borderRadius.lg, borderWidth: 2, borderColor: Theme.colors.border, backgroundColor: Theme.colors.background },
  docOptionSelected: { borderColor: Theme.colors.primary, backgroundColor: `${Theme.colors.primary}10` },
  docInfo: { flexDirection: 'row', alignItems: 'center', gap: Theme.spacing.md },
  docIcon: { width: 48, height: 48, borderRadius: Theme.borderRadius.md, backgroundColor: Theme.colors.surface, alignItems: 'center', justifyContent: 'center' },
  docIconSelected: { backgroundColor: `${Theme.colors.primary}20` },
  docName: { ...Theme.typography.body, fontWeight: 'bold' as const, color: Theme.colors.text },
  docDesc: { ...Theme.typography.caption, color: Theme.colors.textSecondary },
  radio: { width: 24, height: 24, borderRadius: 12, borderWidth: 2, borderColor: Theme.colors.border, alignItems: 'center', justifyContent: 'center' },
  radioSelected: { borderColor: Theme.colors.primary, backgroundColor: Theme.colors.primary },
  radioInner: { width: 8, height: 8, borderRadius: 4, backgroundColor: '#fff' },
  sectionTitle: { ...Theme.typography.caption, fontWeight: 'bold' as const, color: Theme.colors.textSecondary, marginBottom: Theme.spacing.sm, letterSpacing: 1 },
  uploadArea: { width: '100%', aspectRatio: 16/9, borderRadius: Theme.borderRadius.lg, borderWidth: 2, borderColor: `${Theme.colors.primary}60`, borderStyle: 'dashed', backgroundColor: `${Theme.colors.primary}10`, alignItems: 'center', justifyContent: 'center', padding: Theme.spacing.lg, marginBottom: Theme.spacing.md },
  uploadIconContainer: { width: 64, height: 64, borderRadius: 32, backgroundColor: `${Theme.colors.primary}20`, alignItems: 'center', justifyContent: 'center', marginBottom: Theme.spacing.md },
  uploadText: { ...Theme.typography.body, fontWeight: 'bold' as const, color: Theme.colors.primary, marginBottom: Theme.spacing.xs },
  uploadSubtext: { ...Theme.typography.caption, color: Theme.colors.textSecondary, textAlign: 'center' },
  secureNotice: { flexDirection: 'row', backgroundColor: `${Theme.colors.primary}10`, padding: Theme.spacing.md, borderRadius: Theme.borderRadius.md, gap: Theme.spacing.sm, marginTop: Theme.spacing.md },
  secureText: { flex: 1, ...Theme.typography.caption, color: Theme.colors.textSecondary, lineHeight: 20 },
  footer: { padding: Theme.spacing.lg, backgroundColor: Theme.colors.surface, borderTopWidth: 1, borderTopColor: Theme.colors.border },
  footerDocs: { ...Theme.typography.caption, color: Theme.colors.textSecondary, textAlign: 'center', marginTop: Theme.spacing.md },
});
