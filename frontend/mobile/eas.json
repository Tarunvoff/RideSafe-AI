{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://integrate-browser-classes-sonic.trycloudflare.com/api",
        "EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN": "YOUR_MAPBOX_ACCESS_TOKEN"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://integrate-browser-classes-sonic.trycloudflare.com/api",
        "EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN": "YOUR_MAPBOX_ACCESS_TOKEN"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution" : "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://integrate-browser-classes-sonic.trycloudflare.com/api",
        "EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN": "YOUR_MAPBOX_ACCESS_TOKEN"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
