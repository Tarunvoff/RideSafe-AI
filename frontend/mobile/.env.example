# [EXCELLENCE SUMMARY]
# This blueprint defines the environmental variables required to anchor the Aegis mobile client 
# to its geospatial and data-processing backbones. 
#
# [DOMAIN LOGIC]
# Configures the Mapbox bridge for real-time H3 risk-zone visualization and the secure
# API endpoint for parametric insurance state synchronization.

# =========================
# [IN-LINE PRIDE]: Mapbox (Public Token)
# The gateway to high-fidelity risk visualization. Ensure the token has the necessary
# scopes for custom tile-set rendering.
# =========================
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# =========================
# [IN-LINE PRIDE]: Backend API URL
# The primary conduit for actuarial data flow.
# =========================
EXPO_PUBLIC_API_URL=http://localhost:3001/api