# Mapbox public token used by DriverScooterMap component
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# Optional: override the base style. Keep a style that does not require incidents tiles.
# Example: mapbox://styles/mapbox/dark-v11
VITE_MAPBOX_STYLE_URL=

# Backend API base URL. In local dev this can be omitted because Vite proxies /api.
# In production (Vercel), set this to your backend origin + /api.
# Example: https://api.your-domain.com/api
VITE_API_URL=
