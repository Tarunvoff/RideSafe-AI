# ==============================================================================
# AEGIS ML INFRASTRUCTURE - MASTER ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file serves as the single source of truth for all ML microservices.
# Copy this file to '.env' and populate with your production or local keys.
# ==============================================================================

# ── SHARED INFRASTRUCTURE ─────────────────────────────────────────────────────
# Kafka cluster for real-time telemetry ingestion
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis instance for H3 zone state and driver activity feature store
REDIS_URL=redis://localhost:6379/0

# ── EXTERNAL DATA FEEDS ───────────────────────────────────────────────────────
# Newsdata.io API for civic alerts, bandhs, and disaster triggers
NEWSDATA_API_KEY=your_newsdata_api_key_here_abcd123

# TomTom API for real-time traffic density and road closures
TOMTOM_API_KEY=your_tomtom_api_key_here_efgh456

# OpenAQ API (v3) for monitoring atmospheric risk (PM2.5 / AQI)
OPENAQ_API_KEY=your_openaq_api_key_here_ijkl789

# ── INTERNAL SERVICE REGISTRY ─────────────────────────────────────────────────
# Central routing for inter-service communication
ML_SERVICE_URL=http://localhost:8000
ML_INSURANCE_SERVICE_URL=http://localhost:8000
FRAUD_FEATURE_SERVICE_URL=http://localhost:8002
H3_FEATURE_SERVICE_URL=http://localhost:8004
GRID_EVENT_SERVICE_URL=http://localhost:8003

# Backend (NestJS) internal endpoints for pulse-check and status reporting
BACKEND_INTERNAL_URL=http://localhost:3001/internal/zone-state
PLATFORM_API_URL=http://127.0.0.1:3001/api/platform/activity

# ── RUNTIME TUNING ────────────────────────────────────────────────────────────
# STRICT_REALTIME: If true, services reject fallbacks and require 100% live data
STRICT_REALTIME=false

# Timeouts for platform ping-backs (seconds)
PLATFORM_TIMEOUT_SECONDS=6.0

# Initial risk smoothing factor (0.0 to 1.0)
DEFAULT_ZONE_VOLATILITY=0.15

# ==============================================================================
# END OF CONFIGURATION
# ==============================================================================