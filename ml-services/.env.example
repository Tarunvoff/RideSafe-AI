# ==============================================================================
# AEGIS ML INFRASTRUCTURE - MASTER ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- SHARED INFRASTRUCTURE ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_URL=redis://localhost:6379/0

# --- EXTERNAL DATA FEEDS ---
NEWSDATA_API_KEY=your_newsdata_api_key
TOMTOM_API_KEY=your_tomtom_api_key
OPENAQ_API_KEY=your_openaq_api_key
OPEN_WEATHER_API_KEY=your_open_weather_api_key

# --- INTERNAL SERVICE REGISTRY ---
ML_SERVICE_URL=http://localhost:8000
ML_INSURANCE_SERVICE_URL=http://localhost:8000
FRAUD_FEATURE_SERVICE_URL=http://localhost:8002
H3_FEATURE_SERVICE_URL=http://localhost:8004
GRID_EVENT_SERVICE_URL=http://localhost:8003
BACKEND_INTERNAL_URL=http://localhost:3001/internal/zone-state
PLATFORM_API_URL=http://127.0.0.1:3001/api/platform/activity

# --- EXTERNAL INTEGRATIONS ---
DATABASE_URL=postgresql://user:password@localhost:5432/Aegis
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# --- TEST CONFIGURATION (FOR QUALITY ASSURANCE) ---
TEST_DRIVER_NAME="Verified Driver"
TEST_DRIVER_ID=your_test_driver_id
TEST_PHONE_NUMBER=your_test_phone_number
FRAUD_API_URL=http://localhost:8000/fraud/score

# --- RUNTIME TUNING ---
STRICT_REALTIME=false
PLATFORM_TIMEOUT_SECONDS=6.0
DEFAULT_ZONE_VOLATILITY=0.15