import React, { useState, useEffect } from 'react';
import { View, Text, StyleSheet, SafeAreaView, TouchableOpacity, Alert, ActivityIndicator } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { Theme } from '../../theme';
import Button from '../../components/Button';
import { kycApi } from '../../services/api';
import { useAuth } from '../../context/AuthContext';

export default function KYCSubmittedScreen({ navigation }: any) {
  const [submitted, setSubmitted] = useState(false);
  const [isLoading, setIsLoading] = useState(true);
  const { refreshKycStatus } = useAuth();

  useEffect(() => {
    submitKyc();
  }, []);

  const submitKyc = async () => {
    setIsLoading(true);
    try {
      await kycApi.submit();
      await refreshKycStatus();
      setSubmitted(true);
    } catch (e: any) {
      Alert.alert('Error', e.message || 'Failed to submit KYC');
      // Still allow user to continue
      setSubmitted(true);
    } finally {
      setIsLoading(false);
    }
  };

  const handleGoToDashboard = async () => {
    await refreshKycStatus();
    navigation.replace('Home');
  };

  if (isLoading) {
    return (
      <SafeAreaView style={styles.safeArea}>
        <View style={styles.loadingContainer}>
          <ActivityIndicator size="large" color={Theme.colors.primary} />
          <Text style={styles.loadingText}>Submitting your KYC...</Text>
        </View>
      </SafeAreaView>
    );
  }

  return (
    <SafeAreaView style={styles.safeArea}>
      <View style={styles.header}>
        <View style={{width: 40}} />
        <Text style={styles.headerTitle}>KYC Status</Text>
        <View style={{ width: 40 }} />
      </View>

      <View style={styles.container}>
        <View style={styles.content}>
          <View style={styles.iconContainer}>
            <Ionicons name="checkmark-circle" size={100} color={Theme.colors.success} />
          </View>

          <Text style={styles.title}>KYC Submitted Successfully!</Text>
          <View style={styles.badge}>
            <Text style={styles.badgeText}>VERIFICATION IN PROGRESS</Text>
          </View>

          <Text style={styles.subtitle}>
            Your documents have been received and are being reviewed by our compliance team. This usually takes 10-15 minutes.
          </Text>

          <View style={styles.statusBox}>
            <View style={styles.statusRow}>
              <Ionicons name="checkmark-circle" size={24} color={Theme.colors.success} />
              <View style={styles.statusTextCol}>
                <Text style={styles.statusTitle}>Documents Submitted</Text>
                <Text style={styles.statusDesc}>All information saved</Text>
              </View>
            </View>
            <View style={styles.statusLine} />
            <View style={styles.statusRow}>
              <Ionicons name="time" size={24} color={Theme.colors.primary} />
              <View style={styles.statusTextCol}>
                <Text style={styles.statusTitle}>Manual Review</Text>
                <Text style={styles.statusDesc}>Expected within 24 hours</Text>
              </View>
            </View>
          </View>

          <View style={styles.tipsBox}>
            <Text style={styles.tipsTitle}>While you wait...</Text>
            <View style={styles.tipItem}>
              <Ionicons name="checkmark" size={16} color={Theme.colors.success} />
              <Text style={styles.tipText}>You can start browsing available jobs</Text>
            </View>
            <View style={styles.tipItem}>
              <Ionicons name="checkmark" size={16} color={Theme.colors.success} />
              <Text style={styles.tipText}>Set up your payment preferences</Text>
            </View>
            <View style={styles.tipItem}>
              <Ionicons name="checkmark" size={16} color={Theme.colors.success} />
              <Text style={styles.tipText}>Complete your profile setup</Text>
            </View>
          </View>
        </View>
      </View>

      <View style={styles.footer}>
        <Button
          title="Go to Dashboard"
          onPress={handleGoToDashboard}
        />
      </View>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  safeArea: { flex: 1, backgroundColor: Theme.colors.background },
  header: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: Theme.spacing.md, backgroundColor: Theme.colors.surface, borderBottomWidth: 1, borderBottomColor: Theme.colors.border },
  headerTitle: { ...Theme.typography.h3, color: Theme.colors.text },
  container: { flex: 1, padding: Theme.spacing.lg },
  content: { flex: 1, alignItems: 'center', justifyContent: 'center' },
  loadingContainer: { flex: 1, justifyContent: 'center', alignItems: 'center' },
  loadingText: { marginTop: Theme.spacing.lg, ...Theme.typography.body, color: Theme.colors.textSecondary },
  iconContainer: { marginBottom: Theme.spacing.lg },
  title: { ...Theme.typography.h1, color: Theme.colors.text, marginBottom: Theme.spacing.md, textAlign: 'center' },
  badge: { backgroundColor: `${Theme.colors.primary}20`, paddingVertical: 6, paddingHorizontal: 12, borderRadius: Theme.borderRadius.full, marginBottom: Theme.spacing.md },
  badgeText: { ...Theme.typography.caption, fontWeight: 'bold', color: Theme.colors.primary },
  subtitle: { ...Theme.typography.body, color: Theme.colors.textSecondary, textAlign: 'center', marginBottom: Theme.spacing.lg, lineHeight: 22 },
  statusBox: { width: '100%', padding: Theme.spacing.md, backgroundColor: Theme.colors.surface, borderRadius: Theme.borderRadius.md, borderWidth: 1, borderColor: Theme.colors.border, marginBottom: Theme.spacing.lg },
  statusRow: { flexDirection: 'row', alignItems: 'flex-start', gap: Theme.spacing.md },
  statusTextCol: { flex: 1 },
  statusTitle: { ...Theme.typography.body, fontWeight: 'bold', color: Theme.colors.text },
  statusDesc: { ...Theme.typography.caption, color: Theme.colors.textSecondary, marginTop: 2 },
  statusLine: { height: 1, backgroundColor: Theme.colors.border, marginVertical: Theme.spacing.md },
  tipsBox: { width: '100%', padding: Theme.spacing.md, backgroundColor: `${Theme.colors.success}10`, borderRadius: Theme.borderRadius.md, marginBottom: Theme.spacing.md },
  tipsTitle: { ...Theme.typography.body, fontWeight: 'bold', color: Theme.colors.success, marginBottom: Theme.spacing.sm },
  tipItem: { flexDirection: 'row', alignItems: 'center', gap: Theme.spacing.sm, marginBottom: Theme.spacing.sm },
  tipText: { ...Theme.typography.caption, color: Theme.colors.text, flex: 1 },
  footer: { padding: Theme.spacing.lg, backgroundColor: Theme.colors.surface, borderTopWidth: 1, borderTopColor: Theme.colors.border },
});
