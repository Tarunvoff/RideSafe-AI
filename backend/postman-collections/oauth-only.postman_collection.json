{
  "info": {
    "name": "AEGIS OAuth Only",
    "description": "OAuth-focused API collection for AEGIS backend. Includes auth and dynamic q-commerce OAuth flows only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api" },
    { "key": "driverEmail", "value": "driver.oauth360+04012026@example.com" },
    { "key": "driverPassword", "value": "SecurePass123!" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "oauthProvider", "value": "instamart" },
    { "key": "oauthIdentifier", "value": "driver.alpha@example.com" },
    { "key": "oauthSessionId", "value": "" },
    { "key": "oauthState", "value": "" },
    { "key": "oauthCode", "value": "" },
    { "key": "driverId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Driver",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{driverEmail}}\",\n  \"password\": \"{{driverPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login Driver",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{driverEmail}}\",\n  \"password\": \"{{driverPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          }
        }
      ]
    },
    {
      "name": "Dynamic Q-Commerce OAuth",
      "item": [
        {
          "name": "OAuth Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const session = json.oauthSession || {};",
                  "if (session.sessionId) pm.collectionVariables.set('oauthSessionId', session.sessionId);",
                  "if (session.state) pm.collectionVariables.set('oauthState', session.state);",
                  "if (session.authCode) pm.collectionVariables.set('oauthCode', session.authCode);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"{{oauthProvider}}\",\n  \"identifier\": \"{{oauthIdentifier}}\"\n}"
            },
            "url": "{{baseUrl}}/dynamic-qcommerce/oauth/login"
          }
        },
        {
          "name": "OAuth Callback",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const profile = json.driverProfile || {};",
                  "const identity = profile.identity || {};",
                  "if (identity.internalDriverId) pm.collectionVariables.set('driverId', identity.internalDriverId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"{{oauthProvider}}\",\n  \"sessionId\": \"{{oauthSessionId}}\",\n  \"code\": \"{{oauthCode}}\",\n  \"state\": \"{{oauthState}}\"\n}"
            },
            "url": "{{baseUrl}}/dynamic-qcommerce/oauth/callback"
          }
        },
        {
          "name": "Get Driver Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/dynamic-qcommerce/drivers/{{driverId}}/profile"
          }
        }
      ]
    }
  ]
}
