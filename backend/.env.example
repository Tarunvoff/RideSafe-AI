DATABASE_URL="postgresql://user:password@localhost:5432/Aegis"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3001

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Node environment
NODE_ENV=development

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Aegis Config
APP_NAME=Aegis
ADMIN_EMAIL=admin@aegis.local
ADMIN_PASSWORD=your_secure_password

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# NewsData API (Parametric Ingress)
NEWSDATA_API_KEY=your_newsdata_key

# Twilio (WhatsApp Bot)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_phone
TWILIO_WHATSAPP_NUMBER=your_twilio_whatsapp
AUTHORIZED_TEST_PHONE=your_test_phone

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BROKER_URL=localhost:9092

# ML Intelligence
ML_SERVICE_URL=http://localhost:8000
OPEN_WEATHER_API_KEY=your_weather_api_key
FRAUD_FEATURE_SERVICE_URL=http://localhost:8002
GRID_EVENT_SERVICE_URL=http://localhost:8003
H3_FEATURE_SERVICE_URL=http://localhost:8004

# Elite Identity & Provisioning
RECURRING_BILLING_DEBIT_WEBHOOK_URL=http://localhost:3001/api/premium/webhook
RECURRING_BILLING_DEBIT_WEBHOOK_TOKEN=your_secret_token
ELITE_RECURRING_BILLING_ALLOW_STAGED=true
ELITE_OAUTH_ISSUER=https://auth.aegis.local
ELITE_OAUTH_JWT_SECRET=your_elite_jwt_secret
ELITE_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
ELITE_OAUTH_ACCESS_TOKEN_TTL=1h
INTERNAL_AUTH_KEY=aegis_telemetry_elite_2026

# AI Intelligence
GEMINI_API_KEY=your_gemini_api_key
