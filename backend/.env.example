# =========================
# Database
# =========================
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/Aegis_DB"

# =========================
# Redis
# =========================
REDIS_URL="redis://localhost:6379"
ZONE_STATE_TTL_SECONDS=900

# =========================
# Server
# =========================
PORT=3001

# =========================
# JWT
# =========================
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=20m
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# =========================
# Node environment
# =========================
NODE_ENV=development

# =========================
# SMTP (Email)
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# =========================
# Gemini (AI)
# =========================
GEMINI_API_KEY=your_gemini_api_key_here
NEWSDATA_API_KEY=your_newsdata_api_key_here
TOMTOM_API_KEY=your_tomtom_api_key_here
OPENAQ_API_KEY=your_openaq_api_key_here

# =========================
# App
# =========================
APP_NAME=Aegis

# =========================
# Razorpay (Payments)
# =========================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# =========================
# ML / Feature Services
# =========================
ML_SERVICE_URL=http://localhost:8000
H3_SERVICE_URL=http://localhost:8001
FRAUD_FEATURE_SERVICE_URL=http://localhost:8002
GRID_EVENT_SERVICE_URL=http://localhost:8003
BACKEND_INTERNAL_URL=http://localhost:3001/internal/zone-state

# =========================
# Kafka
# =========================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BROKER_URL=localhost:9092

# =========================
# Admin (Seed)
# =========================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=secure_password_here