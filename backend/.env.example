# NestJS backend environment variables
# Copy this file to `.env` (same folder) and adjust as needed.

APP_NAME=RideSafe-AI

# JWT
JWT_SECRET=replace_me
JWT_EXPIRES_IN=20m
JWT_REFRESH_SECRET=replace_me
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (used for OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace_me
SMTP_PASS=replace_me

# Admin hardcoded credentials (used by /auth/admin/login)
ADMIN_EMAIL=replace_me
ADMIN_PASSWORD=replace_me
