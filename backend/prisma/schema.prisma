generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// **User Identity & Security Principal**
///
/// Represents the centralized identity persistence layer. This model is the 
/// primary anchor for the "Zero-Trust" identity pipeline, managing 
/// cryptographic credentials and behavioral risk metadata (fraudWarningCount).
model User {
  id                           String                   @id @default(uuid())
  email                        String                   @unique
  phone                        String?                  @unique
  passwordHash                 String
  role                         Role                     @default(DRIVER)
  isVerified                   Boolean                  @default(false)
  otpCode                      String?
  otpExpiresAt                 DateTime?
  refreshToken                 String?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  driverName                   String?
  platform                     String?
  fraudWarningCount            Int                      @default(0)
  isActive                     Boolean                  @default(true)
  gpsConsentTimestamp          DateTime?
  gpsConsentVersion            String?
  platformDataConsentTimestamp DateTime?
  platformDataPartner          String?
  billingMandates              BillingMandate[]
  claimCases                   ClaimCase[]
  claimFingerprints            ClaimFingerprint[]
  fraudAnalysis                FraudAnalysis?
  kycBasicIdentity             KYCBasicIdentity?
  kycIdentityVerification      KYCIdentityVerification?
  kycPayoutSetup               KYCPayoutSetup?
  kycPersonalDetails           KYCPersonalDetails?
  kycProfile                   KYCProfile?
  policies                     Policy[]
  premiumInvoices              PremiumInvoice[]
  razorpayOrders               RazorpayOrder[]

  @@map("users")
}

model KYCProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  status      KYCStatus @default(NOT_STARTED)
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_profiles")
}

model KYCBasicIdentity {
  id        String   @id @default(uuid())
  userId    String   @unique
  fullName  String
  dob       DateTime
  gender    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_basic_identity")
}

model KYCPersonalDetails {
  id        String   @id @default(uuid())
  userId    String   @unique
  address   String
  city      String
  state     String
  pincode   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_personal_details")
}

model KYCIdentityVerification {
  id            String   @id @default(uuid())
  userId        String   @unique
  aadhaarNumber String
  panNumber     String
  aadhaarDocUrl String?
  panDocUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_identity_verification")
}

model KYCPayoutSetup {
  id                     String       @id @default(uuid())
  userId                 String       @unique
  method                 PayoutMethod @default(UPI)
  upiId                  String?
  accountNumber          String?
  ifscCode               String?
  accountHolder          String?
  bankName               String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  consentVersion         String?
  financialDataConsent   Boolean      @default(false)
  financialDataConsentAt DateTime?
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_payout_setup")
}

model FraudAnalysis {
  id                    String    @id @default(uuid())
  userId                String    @unique
  gpsLatitude           Float?
  gpsLongitude          Float?
  riskScore             Float     @default(0)
  status                String    @default("PENDING")
  deviceIntegrity       String?
  networkType           String?
  velocityCheck         String?
  accelerometerVariance Float?
  barometricPressureHpa  Float?
  acousticMatchConfidence Float?
  isKinematicallyValid  Boolean?
  fraudReason           String?
  analysisDetails       String?
  reviewedAt            DateTime?
  reviewNote            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fraud_analysis")
}

/// **Adversarial High-Concurrency Fraud Prevention**
///
/// Stores unique telemetry fingerprints to prevent multi-device claim spoofing.
/// Utilizes a compound unique constraint to enforce "Temporal Integrity" 
/// across the global H3 grid.
model ClaimFingerprint {
  id              String   @id @default(uuid())
  userId          String
  h3Cell          String   @map("h3_cell")
  eventType       String   @map("event_type")
  claimAmount     Float    @default(0) @map("claim_amount")
  amountBucket    Int      @map("amount_bucket")
  timeBucket      Int      @map("time_bucket")
  fingerprintHash String   @map("fingerprint_hash")
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprintHash, timeBucket])
  @@index([fingerprintHash, createdAt])
  @@index([userId, createdAt])
  @@map("claim_fingerprints")
}

model WeeklyPlan {
  id                      String          @id @default(uuid())
  key                     String          @unique
  name                    String
  price                   Float
  maxPayout               Float           @default(0)
  durationDays            Int             @default(7)
  eligibleDisruptionTypes String[]        @default([])
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  policies                Policy[]
  razorpayOrders          RazorpayOrder[]

  @@map("weekly_plans")
}

model DisruptionEvent {
  id             String            @id @default(uuid())
  type           String
  title          String
  expectedLoss   Float?
  expectedPayout Float?
  occurredAt     DateTime          @default(now())
  expiresAt      DateTime?
  verified       Boolean           @default(false)
  createdAt      DateTime          @default(now())
  claimCases     ClaimCase[]
  payouts        Payout[]
  triggerLogs    TriggerEventLog[]

  @@map("disruption_events")
}

model Policy {
  id              String           @id @default(uuid())
  userId          String
  planType        String
  status          String           @default("ACTIVE")
  premium         Float
  startDate       DateTime
  endDate         DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  weeklyPlanId    String?
  billingMandates BillingMandate[]
  claimCases      ClaimCase[]
  payouts         Payout[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyPlan      WeeklyPlan?      @relation(fields: [weeklyPlanId], references: [id])
  premiumInvoices PremiumInvoice[]

  @@map("policies")
}

model Payout {
  id                String          @id @default(uuid())
  policyId          String
  disruptionEventId String
  status            String          @default("PROCESSING")
  estimatedLoss     Float?          @default(0)
  approvedPayout    Float?          @default(0)
  transactionId     String?
  paymentMethod     String?
  processingTime    String?
  timeline          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  bankReference     String?
  transferredAt     DateTime?
  disruptionEvent   DisruptionEvent @relation(fields: [disruptionEventId], references: [id], onDelete: Cascade)
  policy            Policy          @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, disruptionEventId])
  @@map("payouts")
}

model BillingMandate {
  id                String               @id @default(uuid())
  userId            String
  policyId          String
  provider          String               @default("RAZORPAY")
  providerMandateId String?
  status            BillingMandateStatus @default(ACTIVE)
  nextChargeAt      DateTime
  lastChargedAt     DateTime?
  failureCount      Int                  @default(0)
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  policy            Policy               @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices          PremiumInvoice[]

  @@index([userId, status])
  @@index([policyId, status])
  @@map("billing_mandates")
}

model PremiumInvoice {
  id                String                 @id @default(uuid())
  userId            String
  policyId          String
  mandateId         String?
  billingCycleStart DateTime               @map("billing_cycle_start")
  billingCycleEnd   DateTime               @map("billing_cycle_end")
  amountDue         Float                  @map("amount_due")
  amountPaid        Float?                 @default(0) @map("amount_paid")
  status            PremiumInvoiceStatus   @default(PENDING)
  dueAt             DateTime               @map("due_at")
  paidAt            DateTime?              @map("paid_at")
  failureReason     String?                @map("failure_reason")
  correlationId     String?                @map("correlation_id")
  metadata          Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  attempts          PremiumChargeAttempt[]
  mandate           BillingMandate?        @relation(fields: [mandateId], references: [id])
  policy            Policy                 @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries     PremiumLedgerEntry[]

  @@unique([policyId, billingCycleStart])
  @@index([userId, status, dueAt])
  @@index([status, dueAt])
  @@map("premium_invoices")
}

model PremiumChargeAttempt {
  id               String              @id @default(uuid())
  invoiceId        String
  attemptNumber    Int                 @default(1) @map("attempt_number")
  status           ChargeAttemptStatus @default(STARTED)
  gatewayProvider  String              @default("RAZORPAY") @map("gateway_provider")
  gatewayReference String?             @map("gateway_reference")
  errorCode        String?             @map("error_code")
  errorMessage     String?             @map("error_message")
  correlationId    String?             @map("correlation_id")
  metadata         Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  invoice          PremiumInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, attemptNumber])
  @@index([status, createdAt])
  @@map("premium_charge_attempts")
}

model PremiumLedgerEntry {
  id            String         @id @default(uuid())
  userId        String
  policyId      String
  invoiceId     String
  direction     String
  amount        Float
  currency      String         @default("INR")
  description   String?
  correlationId String?        @map("correlation_id")
  createdAt     DateTime       @default(now())
  invoice       PremiumInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([policyId, createdAt])
  @@map("premium_ledger_entries")
}

model ClaimCase {
  id                String          @id @default(uuid())
  userId            String
  policyId          String
  disruptionEventId String
  payoutId          String?         @unique
  status            ClaimCaseStatus @default(OPEN)
  reasonCode        String?
  fraudScore        Float?
  decisionNote      String?
  correlationId     String?         @map("correlation_id")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  disruptionEvent   DisruptionEvent @relation(fields: [disruptionEventId], references: [id], onDelete: Cascade)
  policy            Policy          @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([policyId, disruptionEventId])
  @@index([userId, status, createdAt])
  @@map("claim_cases")
}

model TriggerEventLog {
  id                String           @id @default(uuid())
  userId            String?
  policyId          String?
  disruptionEventId String?
  h3Cell            String           @map("h3_cell")
  decision          TriggerDecision
  source            String
  reason            String?
  riskScore         Float?
  correlationId     String?          @map("correlation_id")
  eventTimestamp    Int?             @map("event_timestamp")
  createdAt         DateTime         @default(now())
  disruptionEvent   DisruptionEvent? @relation(fields: [disruptionEventId], references: [id])

  @@index([h3Cell, createdAt])
  @@index([decision, createdAt])
  @@index([userId, createdAt])
  @@map("trigger_event_logs")
}

model RazorpayOrder {
  id                String     @id @default(uuid())
  userId            String
  weeklyPlanId      String
  razorpayOrderId   String     @unique
  amount            Int
  currency          String     @default("INR")
  status            String     @default("CREATED")
  razorpayPaymentId String?
  razorpaySignature String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyPlan        WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)

  @@map("razorpay_orders")
}

model AdminSettings {
  id                   String   @id @default(uuid())
  alertThresholds      Json
  riskConfig           Json
  planConfig           Json
  verificationSettings Json
  notifications        Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("admin_settings")
}

model SystemSetting {
  key   String @id
  value String

  @@map("system_settings")
}

model ZoneTelemetryLog {
  id        String   @id @default(uuid())
  h3Cell    String   @map("h3_cell")
  lfScore   Float    @map("lf_score")
  weather   String?
  aqi       Int?
  timestamp DateTime @default(now())

  @@index([timestamp(sort: Desc)])
  @@map("zone_telemetry_logs")
}

model PayoutIdempotencyKey {
  id             String   @id @default(uuid())
  userId         String
  h3Cell         String   @map("h3_cell")
  eventTimestamp Int      @map("event_timestamp")
  payoutState    String   @default("PENDING") @map("payout_state")
  payoutId       String?  @map("payout_id")
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, h3Cell, eventTimestamp])
  @@index([userId])
  @@map("payout_idempotency_keys")
}

model ZoneRiskData {
  id              String   @id @default(cuid())
  h3_cell         String   @unique
  riskScore       Float
  riskLevel       String
  rainfall        Float
  temperature     Float
  aqi             Int
  floodChance     String
  disruptionScore Float
  trafficStatus   String
  activeRiders    Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([h3_cell])
  @@map("zone_risk_data")
}

model KafkaDLQ {
  id         String   @id @default(uuid())
  topic      String
  eventKey   String?  @map("event_key")
  payload    String
  error      String?
  retryCount Int      @default(0) @map("retry_count")
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([topic, status])
  @@index([createdAt])
  @@map("kafka_dlq")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  eventType String
  message   String
  metadata  Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

enum Role {
  DRIVER
  ADMIN
}

enum KYCStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

enum PayoutMethod {
  UPI
  BANK
}

enum BillingMandateStatus {
  ACTIVE
  PAUSED
  FAILED
  REVOKED
}

enum PremiumInvoiceStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  WAIVED
}

enum ChargeAttemptStatus {
  STARTED
  SUCCESS
  FAILED
}

enum ClaimCaseStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
}

enum TriggerDecision {
  APPROVED
  HOLD
  REJECTED
}
