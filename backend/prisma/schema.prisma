// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DRIVER
  ADMIN
}

enum KYCStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

enum PayoutMethod {
  UPI
  BANK
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  phone         String?  @unique
  passwordHash  String
  role          Role     @default(DRIVER)
  isVerified    Boolean  @default(false)
  otpCode       String?
  otpExpiresAt  DateTime?
  refreshToken  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  kycProfile            KYCProfile?
  kycBasicIdentity      KYCBasicIdentity?
  kycPersonalDetails    KYCPersonalDetails?
  kycIdentityVerification KYCIdentityVerification?
  kycPayoutSetup        KYCPayoutSetup?
  fraudAnalysis         FraudAnalysis?
  policies              Policy[]
  razorpayOrders       RazorpayOrder[]

  @@map("users")
}

model KYCProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      KYCStatus @default(NOT_STARTED)
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("kyc_profiles")
}

model KYCBasicIdentity {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  dob       DateTime
  gender    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kyc_basic_identity")
}

model KYCPersonalDetails {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address   String
  city      String
  state     String
  pincode   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kyc_personal_details")
}

model KYCIdentityVerification {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aadhaarNumber  String
  panNumber      String
  aadhaarDocUrl  String?
  panDocUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("kyc_identity_verification")
}

model KYCPayoutSetup {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  method          PayoutMethod @default(UPI)
  upiId           String?
  accountNumber   String?
  ifscCode        String?
  accountHolder   String?
  bankName        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("kyc_payout_setup")
}

model FraudAnalysis {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gpsLatitude       Float?
  gpsLongitude      Float?
  riskScore         Float    @default(0)
  status            String   @default("PENDING")
  deviceIntegrity   String?
  networkType       String?
  velocityCheck     String?
  analysisDetails   String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("fraud_analysis")
}

model WeeklyPlan {
  id                     String   @id @default(uuid())
  key                    String   @unique
  name                   String
  price                  Float
  maxPayout              Float    @default(0)
  durationDays          Int      @default(7)
  eligibleDisruptionTypes String[] @default([])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  policies               Policy[]
  razorpayOrders         RazorpayOrder[]

  @@map("weekly_plans")
}

model DisruptionEvent {
  id           String   @id @default(uuid())
  type         String
  title        String
  expectedLoss Float?
  expectedPayout Float?
  occurredAt   DateTime @default(now())
  expiresAt    DateTime?
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())

  payouts      Payout[]

  @@map("disruption_events")
}

model Policy {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Keeps backward compatibility with any existing UI/data that refers to planType.
  planType     String
  status       String   @default("ACTIVE")
  premium      Float
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  weeklyPlanId String?
  weeklyPlan   WeeklyPlan? @relation(fields: [weeklyPlanId], references: [id], onDelete: SetNull)

  payouts      Payout[]

  @@map("policies")
}

model Payout {
  id String @id @default(uuid())

  policyId           String
  disruptionEventId String

  policy            Policy           @relation(fields: [policyId], references: [id], onDelete: Cascade)
  disruptionEvent  DisruptionEvent  @relation(fields: [disruptionEventId], references: [id], onDelete: Cascade)

  status           String  @default("PROCESSING") // PROCESSING | APPROVED | REJECTED
  estimatedLoss   Float?  @default(0)
  approvedPayout  Float?  @default(0)
  transactionId   String?
  paymentMethod   String?
  processingTime  String?

  // Optional timeline for UI.
  timeline         Json?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([policyId, disruptionEventId])
  @@map("payouts")
}

model RazorpayOrder {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weeklyPlanId String
  weeklyPlan   WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)

  razorpayOrderId String @unique
  amount Int
  currency String @default("INR")

  status String @default("CREATED") // CREATED | SUCCESS | FAILED

  razorpayPaymentId String?
  razorpaySignature String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("razorpay_orders")
}
