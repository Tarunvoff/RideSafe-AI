{
  "name": "aegis-backend",
  "version": "1.0.0",
  "description": "Aegis NestJS backend - Auth + KYC",
  "scripts": {
    "build": "npx nest build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation npx nest start",
    "start:dev": "cross-env NODE_OPTIONS=--no-deprecation npx nest start --watch",
    "start:debug": "cross-env NODE_OPTIONS=--no-deprecation npx nest start --debug --watch",
    "start:prod": "cross-env NODE_OPTIONS='--no-deprecation' node dist/main",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:reset-seed": "prisma migrate reset --force && prisma db seed",
    "test:unit": "jest --runInBand",
    "test": "jest"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.3.5",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^10.3.5",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.4.22",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.5",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.10.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.41.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "h3-js": "^4.4.0",
    "kafkajs": "^2.2.4",
    "nodemailer": "^6.9.13",
    "opossum": "^8.1.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.1.0",
    "pino-pretty": "^11.0.0",
    "razorpay": "^2.9.6",
    "redis": "^5.11.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "twilio": "^5.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.5",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.2",
    "@types/nodemailer": "^6.4.14",
    "@types/opossum": "^8.1.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/twilio": "^0.0.10",
    "cross-env": "^10.1.0",
    "jest": "^30.3.0",
    "prisma": "^5.10.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  }
}
