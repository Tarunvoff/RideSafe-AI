  @HttpCode(HttpStatus.OK)
  async setZoneState(
    @Body()
    payload: {
      h3_cell: string;
      Lf: number;
      zone_state: string;
      rainfall_mm?: number;
      aqi?: number;
      demand_ratio?: number;
