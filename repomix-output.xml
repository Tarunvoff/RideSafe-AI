if not exist ml-services\.venv\Scripts\activate.bat (
    pushd ml-services
    python -m venv .venv
    popd
)

echo [3/8] Finalizing Backend Infrastructure...
cd /d %~dp0..\..\backend
call npm install
echo 🛠️  Pushing Actuarial Schema to Database...
