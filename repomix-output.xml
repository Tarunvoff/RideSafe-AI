                ) : null}

                {readItems.length > 0 ? (
                  <View style={styles.groupBlock}>
                    <Text style={styles.groupTitle}>Earlier</Text>
                    {readItems.map((item) => (
                      <View key={item.id} style={styles.readCard}>
