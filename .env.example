# =============================================================================
# RideSafe-AI (Aegis) — Docker Compose root secrets file
# Copy this to .env and fill in real values before running: docker-compose up
# This file is read by docker-compose for ${VAR} substitution.
# NEVER commit the filled .env to git.
# =============================================================================

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_jwt_secret_min_64_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_64_chars

# ── SMTP ───────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# ── AI / External APIs ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
NEWSDATA_API_KEY=your_newsdata_api_key

# ── Razorpay ───────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── Admin seed ─────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password
